{
  "name": "kurdify",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write .",
    "prepare": "husky install",
    "postinstall": "node -e \"console.log('Run npx husky-init && npm run prepare to set up git hooks locally')\""
  },
  "dependencies": {
    "expo": "~53.0.0",
    "react": "18.3.1",
    "react-native": "0.76.2",
    "@supabase/supabase-js": "^2.0.0",
    "expo-av": "~15.0.1",
    "@react-navigation/native": "^6.1.0",
    "@react-navigation/native-stack": "^6.9.12",
    "react-native-gesture-handler": "~2.20.2",
    "react-native-reanimated": "~3.16.1",
    "nativewind": "^2.0.11"
  },
  "devDependencies": {
    "@types/react": "~18.3.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.48.0",
    "husky": "^8.0.0",
    "lint-staged": "^14.0.0",
    "prettier": "^2.8.8",
    "typescript": "~5.6.2"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "npm run lint",
      "npm run format"
    ]
  }
}
